/-!
# Finite-dimensional operator estimates for state-dependent distance

This module contains finite-dimensional operator and finite-sum identities used
by the paper-facing distance theorems. It introduces no new mathematical
assumptions or source-facing statements.

## References

- `references/qpbt-paper/06_nonlocal_games_and_mipstar.tex:295-395`
- `references/ldt-paper/preliminaries.tex:649-666`
-/



open scoped BigOperators Matrix MatrixOrder ComplexOrder

open MIPStarRE.QPBT.DistanceCalculus

open LIDT.MIPStarRE.LDT LIDT.MIPStarRE.Quantum
open LIDT.MIPStarRE.LDT.MakingMeasurementsProjective

theorem MIPStarRE.QPBT.DistanceCalculus.point_defect_eq {α ι : Type*} [Fintype α] [DecidableEq α]
    [Fintype ι] [DecidableEq ι]
    (A B : _root_.LIDT.MIPStarRE.Quantum.Measurement α ι)
    (ψ : EuclideanSpace ℂ ι) :
    (∑ a : α, ∑ b : α,
      if a = b then 0 else _root_.MIPStarRE.QPBT.DistanceCalculus.stateQForm ψ (A.effect a * B.effect b)) =
      ‖ψ‖ ^ 2 - ∑ a : α, _root_.MIPStarRE.QPBT.DistanceCalculus.stateQForm ψ (A.effect a * B.effect a) := by sorry
