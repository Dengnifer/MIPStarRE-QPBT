theorem MIPStarRE.QPBT.DistanceCalculus.sum_norm_sub_apply_sq_le_four {α ι : Type*} [Fintype α]
    [Fintype ι] [DecidableEq ι] (A B : α → _root_.LIDT.MIPStarRE.Quantum.Op ι) (ψ : EuclideanSpace ℂ ι)
    (hψ : ‖ψ‖ = 1) (hA : ∑ a : α, (A a)ᴴ * A a ≤ 1)
    (hB : ∑ a : α, (B a)ᴴ * B a ≤ 1) :
    ∑ a : α, ‖_root_.MIPStarRE.QPBT.applyOperatorToState (A a - B a) ψ‖ ^ 2 ≤ 4 := by sorry
