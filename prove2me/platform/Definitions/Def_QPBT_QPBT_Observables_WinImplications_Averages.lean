/-- The question pair generated by a fixed ordered Pauli edge and seed. -/
def pauliSourceQuestions (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (e : _root_.MIPStarRE.QPBT.PauliEdge)
    (z : _root_.MIPStarRE.QPBT.PauliSpace P) : _root_.MIPStarRE.QPBT.PauliQuestion P × _root_.MIPStarRE.QPBT.PauliQuestion P :=
  ((e.1.1, _root_.MIPStarRE.QPBT.pauliCL P e.1.1 z), (e.1.2, _root_.MIPStarRE.QPBT.pauliCL P e.1.2 z))

/-- Rejection mass at a fixed ordered Pauli edge and seed. -/
noncomputable def pauliRejectionAt {P : _root_.MIPStarRE.QPBT.AdmissibleParams}
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)) (e : _root_.MIPStarRE.QPBT.PauliEdge) (z : _root_.MIPStarRE.QPBT.PauliSpace P) : ℝ :=
  let questions := _root_.MIPStarRE.QPBT.WinImplications.pauliSourceQuestions P e z
  _root_.MIPStarRE.QPBT.outcomeEventWeight S questions.1 questions.2 fun a b =>
    (_root_.MIPStarRE.QPBT.pauliBasisTest P).decide questions.1 questions.2 a b = false










end WinImplications

